// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Problem {
  id                  Int      @id @default(autoincrement())
  title               String  @default("Check if number is palindrome")
  content             String  @default("Check if number is palindrome")
  driver_code_c       String?
  driver_code_cpp     String?
  driver_code_python  String?
  driver_code_java    String?
  solution_code_cpp   String  @default("class Solution{\n    public:\n    bool isPalindrome(string s){\n        for (int i = 0; i < s.length(); i++){\n            if (s[i] != s[s.length()-1-i])\n                return 0;\n        }\n        return 1;\n    }\n};")
  testcases           String
  difficulty          String  @default("Easy")
}

model Submission {
  id            Int      @id @default(autoincrement())
  user_id       Int
  problem_id    Int
  runtime       Float
  passed_cases  Int
  failed_case   String?
}

model User {
  id            Int      @id @default(autoincrement())
  username      String
  password      String
}